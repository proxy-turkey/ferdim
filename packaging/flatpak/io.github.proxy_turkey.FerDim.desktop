[Desktop Entry]
Type=Application
Name=FerDim Download Manager
GenericName=Download Manager
Comment=Dynamic, self-tuning segmented download manager with Firefox integration
Exec=ferdim-gui
Icon=io.github.proxy_turkey.FerDim
Terminal=false
Categories=Network;FileTransfer;GTK;
Keywords=download;manager;segmented;firefox;http;ftp;
StartupNotify=true
# ferdim/gui/app.py currently registers Gtk.Application(application_id=
# "app.ferdim.gui"); this keeps window grouping correct until that id is
# aligned with the Flatpak app id.
StartupWMClass=app.ferdim.gui
