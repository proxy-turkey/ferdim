# Maintainer: Enes Aksu <eaksu@pm.me>
pkgname=ferdim
pkgver=1.5.1
pkgrel=1
pkgdesc="Dynamic, self-tuning segmented download manager with a Firefox extension"
arch=('any')
url="https://github.com/proxy-turkey/ferdim"
license=('MIT')
depends=('python' 'hicolor-icon-theme')
makedepends=('zip')
checkdepends=('python')
optdepends=('python-gobject: GTK 4 front-end (ferdim-gui) and D-Bus bridge'
            'gtk4: GTK 4 front-end'
            'firefox: browser integration'
            'wl-clipboard: clipboard watching on Wayland'
            'python-aioquic: HTTP/3 transport')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('20ced0df037cb796fd2ee6f57e9560fa86addb6753d81d95c2e1871b21d7511a')

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  local share="$pkgdir/usr/share/$pkgname"

  install -d "$share"
  cp -a ferdim web "$share/"
  find "$share" -name '__pycache__' -type d -prune -exec rm -rf {} +

  install -Dm755 bin/ferdim     "$pkgdir/usr/bin/ferdim"
  install -Dm755 bin/ferdim-nm  "$pkgdir/usr/bin/ferdim-nm"
  install -Dm755 bin/ferdim-gui "$pkgdir/usr/bin/ferdim-gui"

  install -d "$pkgdir/usr/share/applications"
  sed 's|@BIN@|/usr/bin/ferdim-gui|' scripts/ferdim.desktop \
    > "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 scripts/icons/ferdim.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  local m
  for m in ferdim ferdim-nm ferdim-gui; do
    install -Dm644 "docs/$m.1" "$pkgdir/usr/share/man/man1/$m.1"
    install -Dm644 "docs/tr/$m.1" "$pkgdir/usr/share/man/tr/man1/$m.1"
  done

  install -d "$pkgdir/usr/lib/systemd/user"
  sed 's|@BIN@|/usr/bin/ferdim|' scripts/systemd/ferdim.service \
    > "$pkgdir/usr/lib/systemd/user/$pkgname.service"

  # Firefox native messaging registration (system-wide location)
  install -d "$pkgdir/usr/lib/mozilla/native-messaging-hosts"
  cat > "$pkgdir/usr/lib/mozilla/native-messaging-hosts/$pkgname.json" <<EOF
{
  "name": "$pkgname",
  "description": "FerDim Download Manager integration",
  "path": "/usr/bin/ferdim-nm",
  "type": "stdio",
  "allowed_extensions": ["ferdim@ferdim.app"]
}
EOF

  (cd extension && zip -qr "$share/$pkgname-extension.zip" .)
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
