{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.8.0",
  "description": "__MSG_extDesc__",
  "author": "Enes Aksu",
  "browser_specific_settings": {
    "gecko": {
      "id": "ferdim@ferdim.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "downloads",
    "webRequest",
    "contextMenus",
    "cookies",
    "storage",
    "tabs",
    "notifications",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["sniff.js", "background.js"]
  },
  "action": {
    "default_title": "FerDim",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "page_action": {
    "default_title": "__MSG_pageActionTitle__",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
