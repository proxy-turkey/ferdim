#!/bin/sh
# FerDim CLI - paket (RPM: /usr/share/ferdim) ve kullanici kurulumlarini bulur
SELF="$(readlink -f "$0")"
FERDIM_LIB=""
for d in "$(dirname "$SELF")/../share/ferdim" \
         "$(dirname "$SELF")/../lib/ferdim" \
         /usr/share/ferdim /usr/lib/ferdim; do
    if [ -f "$d/ferdim/cli.py" ]; then FERDIM_LIB="$d"; break; fi
done
if [ -z "$FERDIM_LIB" ]; then
    echo "ferdim: kutuphane bulunamadi (ferdim/cli.py)" >&2
    exit 1
fi
export PYTHONPATH="$FERDIM_LIB${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m ferdim.cli "$@"
