#!/bin/sh
# FerDim GTK4 arayuzu
SELF="$(readlink -f "$0")"
FERDIM_LIB=""
for d in "$(dirname "$SELF")/../share/ferdim" \
         "$(dirname "$SELF")/../lib/ferdim" \
         /usr/share/ferdim /usr/lib/ferdim; do
    if [ -f "$d/ferdim/gui/app.py" ]; then FERDIM_LIB="$d"; break; fi
done
if [ -z "$FERDIM_LIB" ]; then
    echo "ferdim-gui: kutuphane bulunamadi (python3-gobject kurulu mu?)" >&2
    exit 1
fi
export PYTHONPATH="$FERDIM_LIB${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m ferdim.gui "$@"
